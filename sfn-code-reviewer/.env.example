# sfn-code-reviewer — local settings. Copy to `.env` (git-ignored) and fill in only what you use.
# scripts/run-review.sh loads `.env` from the sfn-code-reviewer folder if it exists.
# In CI none of this file is used: keys come from the `sfn-code-reviewer` variable group.
# Never commit real values.

# ---------------------------------------------------------------- Claude (default engine)
# Leave EMPTY to use your Claude Code login (no key needed locally).
# Set it to run exactly like CI (minimal mode, per-review budget cap).
ANTHROPIC_API_KEY=

# Or Claude via Microsoft Foundry (Azure credentials instead of an Anthropic key):
# CLAUDE_CODE_USE_FOUNDRY=1

# ---------------------------------------------------------------- OpenAI engine (--engine openai)
# Needed only for --engine openai or --cross-verify with Claude as the primary engine.
OPENAI_API_KEY=
# Azure OpenAI instead: set the key and point the base URL at your resource
# (model names in config/review.config.yml are then your deployment names).
# AZURE_OPENAI_API_KEY=
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1

# ---------------------------------------------------------------- Azure DevOps (PR review/post, Boards, metrics, feedback)
# Optional: without it the scripts use your `az login`.
# Personal access token scopes: Code (Read & Write) for PR comments, Work Items (Read & Write) for /sfn:bugs.
# AZURE_DEVOPS_PAT=

# ---------------------------------------------------------------- Live DB schema (--live-db)
# A READ-ONLY Postgres role (CONNECT + schema USAGE, no table writes). Metadata only is read.
# SFN_REVIEW_DB_URL=postgres://<readonly_user>:<password>@<host>:5432/<db>

# ---------------------------------------------------------------- Toggles
# SFN_SKIP_REVIEW=1      # skip the pre-push hook once
